{% doc %}
  @prompt
    make a searchable recipes page
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-recipes-page-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .ai-recipes-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-recipes-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
  }

  .ai-recipes-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .ai-recipes-controls-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    margin-bottom: 40px;
    flex-wrap: wrap;
  }

  .ai-recipes-search-wrapper-{{ ai_gen_id }} {
    flex: 1;
    min-width: 250px;
  }

  .ai-recipes-search-{{ ai_gen_id }} {
    width: 100%;
    padding: 12px 16px;
    border: 2px solid {{ block.settings.input_border_color }};
    border-radius: {{ block.settings.input_border_radius }}px;
    font-size: 16px;
    background-color: {{ block.settings.input_bg_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-recipes-search-{{ ai_gen_id }}::placeholder {
    color: {{ block.settings.text_color }};
    opacity: 0.6;
  }

  .ai-recipes-filter-wrapper-{{ ai_gen_id }} {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }

  .ai-recipes-filter-{{ ai_gen_id }} {
    padding: 10px 20px;
    border: 2px solid {{ block.settings.filter_border_color }};
    border-radius: {{ block.settings.filter_border_radius }}px;
    background-color: {{ block.settings.filter_bg_color }};
    color: {{ block.settings.filter_text_color }};
    cursor: pointer;
    font-size: 14px;
    transition: all 0.3s ease;
  }

  .ai-recipes-filter-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.filter_hover_bg_color }};
    color: {{ block.settings.filter_hover_text_color }};
    border-color: {{ block.settings.filter_hover_border_color }};
  }

  .ai-recipes-filter-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.filter_active_bg_color }};
    color: {{ block.settings.filter_active_text_color }};
    border-color: {{ block.settings.filter_active_border_color }};
  }

  .ai-recipes-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 24px;
    margin-bottom: 40px;
  }

  .ai-recipes-card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    border: 2px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-recipes-card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);
  }

  .ai-recipes-card-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-recipes-card-image-{{ ai_gen_id }} {
    width: 100%;
    height: 250px;
    overflow: hidden;
  }

  .ai-recipes-card-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-recipes-card-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-recipes-card-placeholder-{{ ai_gen_id }} svg {
    width: 80px;
    height: 80px;
    opacity: 0.3;
  }

  .ai-recipes-card-content-{{ ai_gen_id }} {
    padding: 20px;
  }

  .ai-recipes-card-category-{{ ai_gen_id }} {
    display: inline-block;
    padding: 4px 12px;
    background-color: {{ block.settings.category_bg_color }};
    color: {{ block.settings.category_text_color }};
    border-radius: 20px;
    font-size: 12px;
    margin-bottom: 12px;
    text-transform: uppercase;
    font-weight: 600;
  }

  .ai-recipes-card-title-{{ ai_gen_id }} {
    font-size: 20px;
    color: {{ block.settings.card_title_color }};
    margin: 0 0 12px;
    font-weight: 600;
  }

  .ai-recipes-card-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    margin: 0 0 16px;
    line-height: 1.5;
  }

  .ai-recipes-card-link-{{ ai_gen_id }} {
    display: inline-block;
    padding: 10px 20px;
    background-color: {{ block.settings.button_bg_color }};
    color: {{ block.settings.button_text_color }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
    transition: background-color 0.3s ease;
  }

  .ai-recipes-card-link-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_bg_color }};
  }

  .ai-recipes-no-results-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: {{ block.settings.text_color }};
    font-size: 18px;
    display: none;
  }

  .ai-recipes-no-results-{{ ai_gen_id }}.visible {
    display: block;
  }

  @media screen and (max-width: 768px) {
    .ai-recipes-controls-{{ ai_gen_id }} {
      flex-direction: column;
    }

    .ai-recipes-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
    }
  }
{% endstyle %}

<recipes-search-{{ ai_gen_id }} class="ai-recipes-page-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-recipes-header-{{ ai_gen_id }}">
    {% if block.settings.title != blank %}
      <h1 class="ai-recipes-title-{{ ai_gen_id }}">{{ block.settings.title }}</h1>
    {% endif %}
    {% if block.settings.description != blank %}
      <div class="ai-recipes-description-{{ ai_gen_id }}">{{ block.settings.description }}</div>
    {% endif %}
  </div>

  <div class="ai-recipes-controls-{{ ai_gen_id }}">
    <div class="ai-recipes-search-wrapper-{{ ai_gen_id }}">
      <input
        type="text"
        class="ai-recipes-search-{{ ai_gen_id }}"
        placeholder="{{ block.settings.search_placeholder }}"
        aria-label="Search recipes"
      >
    </div>
    <div class="ai-recipes-filter-wrapper-{{ ai_gen_id }}">
      <button class="ai-recipes-filter-{{ ai_gen_id }} active" data-filter="all">
        All Recipes
      </button>
      {% if block.settings.show_breakfast %}
        <button class="ai-recipes-filter-{{ ai_gen_id }}" data-filter="breakfast">
          Breakfast
        </button>
      {% endif %}
      {% if block.settings.show_lunch %}
        <button class="ai-recipes-filter-{{ ai_gen_id }}" data-filter="lunch">
          Lunch
        </button>
      {% endif %}
      {% if block.settings.show_dinner %}
        <button class="ai-recipes-filter-{{ ai_gen_id }}" data-filter="dinner">
          Dinner
        </button>
      {% endif %}
      {% if block.settings.show_dessert %}
        <button class="ai-recipes-filter-{{ ai_gen_id }}" data-filter="dessert">
          Dessert
        </button>
      {% endif %}
      {% if block.settings.show_drinks %}
        <button class="ai-recipes-filter-{{ ai_gen_id }}" data-filter="drinks">
          Drinks
        </button>
      {% endif %}
    </div>
  </div>

  <div class="ai-recipes-grid-{{ ai_gen_id }}">
    {% for i in (1..12) %}
      {% liquid
        assign recipe_enabled_key = 'recipe_' | append: i | append: '_enabled'
        assign recipe_title_key = 'recipe_' | append: i | append: '_title'
        assign recipe_description_key = 'recipe_' | append: i | append: '_description'
        assign recipe_category_key = 'recipe_' | append: i | append: '_category'
        assign recipe_image_key = 'recipe_' | append: i | append: '_image'
        assign recipe_link_key = 'recipe_' | append: i | append: '_link'

        assign recipe_enabled = block.settings[recipe_enabled_key]
        assign recipe_title = block.settings[recipe_title_key]
        assign recipe_description = block.settings[recipe_description_key]
        assign recipe_category = block.settings[recipe_category_key]
        assign recipe_image = block.settings[recipe_image_key]
        assign recipe_link = block.settings[recipe_link_key]
      %}

      {% if recipe_enabled %}
        <div
          class="ai-recipes-card-{{ ai_gen_id }}"
          data-category="{{ recipe_category }}"
          data-title="{{ recipe_title | downcase }}"
          data-description="{{ recipe_description | downcase }}"
        >
          <div class="ai-recipes-card-image-{{ ai_gen_id }}">
            {% if recipe_image %}
              <img
                src="{{ recipe_image | image_url: width: 600 }}"
                alt="{{ recipe_image.alt | escape }}"
                loading="lazy"
                width="600"
                height="400"
              >
            {% else %}
              <div class="ai-recipes-card-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          <div class="ai-recipes-card-content-{{ ai_gen_id }}">
            <span class="ai-recipes-card-category-{{ ai_gen_id }}">{{ recipe_category }}</span>
            <h3 class="ai-recipes-card-title-{{ ai_gen_id }}">{{ recipe_title }}</h3>
            <p class="ai-recipes-card-description-{{ ai_gen_id }}">{{ recipe_description }}</p>
            {% if recipe_link != blank %}
              <a href="{{ recipe_link }}" class="ai-recipes-card-link-{{ ai_gen_id }}">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>

  <div class="ai-recipes-no-results-{{ ai_gen_id }}">
    {{ block.settings.no_results_text }}
  </div>
</recipes-search-{{ ai_gen_id }}>

<script>
  (function() {
    class RecipesSearch{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.searchInput = this.querySelector('.ai-recipes-search-{{ ai_gen_id }}');
        this.filterButtons = this.querySelectorAll('.ai-recipes-filter-{{ ai_gen_id }}');
        this.recipeCards = this.querySelectorAll('.ai-recipes-card-{{ ai_gen_id }}');
        this.noResults = this.querySelector('.ai-recipes-no-results-{{ ai_gen_id }}');
        this.currentFilter = 'all';
      }

      connectedCallback() {
        this.searchInput.addEventListener('input', () => this.filterRecipes());
        
        this.filterButtons.forEach(button => {
          button.addEventListener('click', (e) => {
            this.filterButtons.forEach(btn => btn.classList.remove('active'));
            e.target.classList.add('active');
            this.currentFilter = e.target.dataset.filter;
            this.filterRecipes();
          });
        });
      }

      filterRecipes() {
        const searchTerm = this.searchInput.value.toLowerCase();
        let visibleCount = 0;

        this.recipeCards.forEach(card => {
          const category = card.dataset.category;
          const title = card.dataset.title;
          const description = card.dataset.description;

          const matchesFilter = this.currentFilter === 'all' || category === this.currentFilter;
          const matchesSearch = searchTerm === '' || 
                               title.includes(searchTerm) || 
                               description.includes(searchTerm);

          if (matchesFilter && matchesSearch) {
            card.classList.remove('hidden');
            visibleCount++;
          } else {
            card.classList.add('hidden');
          }
        });

        if (visibleCount === 0) {
          this.noResults.classList.add('visible');
        } else {
          this.noResults.classList.remove('visible');
        }
      }
    }

    customElements.define('recipes-search-{{ ai_gen_id }}', RecipesSearch{{ ai_gen_id }});
  })();
</script>

