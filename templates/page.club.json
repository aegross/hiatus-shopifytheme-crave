        "column_UJDjHM": {
          "type": "column",
          "settings": {
            "title": "Free Membership with any Bottle Subscription",
            "text": "<p>There’s no fee to join the Lollygagger Club — <strong>membership is free with with a qualifying active subscription.</strong></p><ul><li>Subscribe to at least one bottle per quarter (four per year) to keep your membership active.</li><li>Receive up to 25% off<strong> ALL</strong> bottles, merchandise, and Hiatus events.</li><li>Get one weekly <strong>complimentary tasting flight </strong>for you and a guest during regular business hours.</li></ul>",
            "link_label": "",
            "link": ""
          }
        },
        "column_wY96GP": {
          "type": "column",
          "settings": {
            "title": "More Member Benefits",
            "text": "<ul><li><strong>Exclusive Access</strong> to member-only events, distillery workshops, tours, and tasting panels, giving you a voice in product development.</li><li><strong>First Access</strong> to new products, including single-barrel bottlings.</li><li><strong>Earn Loyalty Points</strong> on all purchases. Get <strong>3 points for every $1 spent</strong>, with bonus points for referrals, birthdays, and social shares. Redeem your points for discounts on future purchases.</li></ul>",
            "link_label": "",
            "link": ""
          }
        }
