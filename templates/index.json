      "type": "collapsible-content",
      "blocks": {
        "collapsible_row_QHHVxq": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Spirit Tasting",
            "icon": "check_mark",
            "row_content": "<p><strong>Tasting Room Hours:</strong><br/>Saturdays 12:00 - 6:00pm<br/>Sundays 1:00 - 5:00pm<br/><br/>Book a spirit tasting during which you can either enjoy a <strong>flight</strong> and select up to six mini-shots from our spirits collection (¼ oz each) or a <strong>cocktail</strong> featuring our spirits. Maximum of 1½ ounces of spirits per person, per day.<br/><br/>We do not serve food but you are welcome to bring your own!<br/><br/><strong>→</strong> <a href=\"/collections/tastings\" target=\"_blank\" title=\"Tastings\"><strong>Spirit Tasting</strong></a></p>",
            "page": ""
          }
        },
        "collapsible_row_fQanAW": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Exclusive Buyout",
            "icon": "check_mark",
            "row_content": "<p>Book an Exclusive Buyout of our Tasting Room, available Wednesday, Thursday, and Friday from 5:00-7:30PM.</p><p><strong>Each booking includes:</strong></p><ul><li>Exclusive access to our Tasting Room for up to 20 guests for 2.5 hours.</li><li>Discounts on spirit bottles and merchandise.</li><li>Bar service with cocktails and spirit flights at $10 each.</li><li>Option of a standard cash bar or host tab.</li><li>Beer and wine upon request; prices vary per serving.<br/></li></ul><p>→ <a href=\"https://hiatuscrafthouse.com/products/private-happy-hour\" target=\"_blank\" title=\"https://hiatuscrafthouse.com/products/private-happy-hour\"><strong>Exclusive Buyout</strong></a></p>",
            "page": ""
          }
        },
        "collapsible_row_DhNXQH": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Venue Rental",
            "icon": "check_mark",
            "row_content": "<p>Host your event at Hiatus Craft House!<br/><br/>We offer two unique spaces to rent out for your event. Both spaces can be utilized to accommodate your event's needs. Venue rentals start at $10 per person, and can be reserved for up to 8 hours and for as many as 120 guests.<br/><br/>→ <a href=\"https://hiatuscrafthouse.com/pages/venue-rental\" target=\"_blank\" title=\"Venue Rental\"><strong>Venue Rental</strong></a></p>",
            "page": ""
          }
        },
